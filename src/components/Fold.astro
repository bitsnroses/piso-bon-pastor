---
// L1 fold (E3 §6): native <details>, closed, its content in the HTML from the start.
// The anchor id sits on an element INSIDE the <details>, not on the summary, so the browser can
// reveal it when the page is reached by it (ADR-001 §7.4). "open_with" opens it from another
// anchor (#invertir opens its data).
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { inline, plain } from "../lib/typography.mjs";

interface Props { block: CollectionEntry<"blocks">; ui: { enlarge: string } }
const { block, ui } = Astro.props;
const b = block.data;
if (b.type !== "fold") throw new Error("Fold expects a fold block");
const { Content } = await render(block);
---
<details class="fold" data-open-with={b.open_with}>
  <summary set:html={inline(b.summary)} />
  <div class="fold-body" id={b.anchor}>
    <div class="prose"><Content /></div>
    {b.image && (
      <figure class="fold-image" data-gallery>
        <a class="ph plan-ph" href={b.image.src.src} data-caption={b.image.caption ? plain(b.image.caption) : undefined}>
          <Image src={b.image.src} alt={plain(b.image.alt)} widths={[480, 720, 1080]} sizes="(min-width: 37.5rem) 34rem, calc(100vw - 3.5rem)" />
          <span class="sr-only">{ui.enlarge}</span>
        </a>
      </figure>
    )}
  </div>
</details>
