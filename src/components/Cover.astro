---
// Block 2. The cover slot (E4): a diptych of the two halves of the character, living room and
// rooftop, with no motion (E7). 4:3 in portrait, full height under the header in landscape.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { inline, plain } from "../lib/typography.mjs";

interface Props { block: CollectionEntry<"blocks">; }
const b = Astro.props.block.data;
if (b.type !== "cover") throw new Error("Cover expects a cover block");
---
<section id={b.anchor} aria-labelledby="titular">
  <div class="cover-photos">
    {b.photos.map((p) => (
      <Image
        src={p.src}
        alt={plain(p.alt)}
        widths={[360, 540, 720, 960, 1280]}
        sizes="50vw"
        loading="eager"
        fetchpriority="high"
        style={p.focus ? `object-position:${p.focus}` : undefined}
      />
    ))}
  </div>
  <div class="col pt-[1.1rem]">
    <h1 class="h-display" id="titular" set:html={inline(b.title)} />
  </div>
</section>
