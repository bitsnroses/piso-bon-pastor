---
// One photo: a link to the large version (opened in the <dialog> viewer when JavaScript runs),
// the responsive image, and its caption. The most repeated component of the page (E3 §8).
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { inline, plain } from "../lib/typography.mjs";

interface Props {
  photo: { src: ImageMetadata; alt: string; caption?: string; focus?: string };
  sizes: string;
  enlarge: string;
  eager?: boolean;
  caption?: boolean;
}
const { photo, sizes, enlarge, eager = false, caption = true } = Astro.props;
const large = await getImage({ src: photo.src, width: Math.min(1800, photo.src.width), format: "webp", quality: 78 });
const alt = plain(photo.alt);
---
<figure>
  <a class="ph" href={large.src} data-caption={photo.caption ? plain(photo.caption) : undefined}>
    <Image
      src={photo.src}
      alt={alt}
      widths={[400, 640, 960, 1280]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      style={photo.focus ? `object-position:${photo.focus}` : undefined}
    />
    <span class="sr-only">{enlarge}</span>
  </a>
  {caption && photo.caption && <figcaption class="small" set:html={inline(photo.caption)} />}
</figure>
