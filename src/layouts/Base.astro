---
// Document shell: <head>, fonts, and the page's only script (folds by anchor + photo viewer).
import "../styles/global.css";
import instrumentSans from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { url } from "../lib/site";

interface Props {
  lang: string;
  locale: string;
  title: string;
  description: string;
  canonical: URL;
  ogImage?: ImageMetadata;
  ogAlt?: string;
  bodyClass?: string;
}
const { lang, locale, title, description, canonical, ogImage, ogAlt, bodyClass } = Astro.props;
// Link preview (block 0): 1200 × 630 from the first cover photo. E9 checks it in WhatsApp.
const og = ogImage ? await getImage({ src: ogImage, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 80 }) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="manifest" href={url("/site.webmanifest")} />
    <meta name="theme-color" content="#2B2320" />
    <link rel="preload" href={instrumentSans} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {og && <meta property="og:image" content={new URL(og.src, canonical).href} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {og && ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      (function () {
        // 1. A fold opens when the page is reached by its anchor (ADR-001 §7.4).
        //    Without this script the reader lands on the closed fold with its summary visible.
        function openByHash() {
          var id = decodeURIComponent(location.hash.slice(1));
          if (!id) return;
          var target = document.getElementById(id);
          var inside = target && target.closest("details");
          if (inside && !inside.open) { inside.open = true; target.scrollIntoView(); }
          document.querySelectorAll("details[data-open-with]").forEach(function (d) {
            if (d.getAttribute("data-open-with") === id) d.open = true;
          });
        }
        openByHash();
        window.addEventListener("hashchange", openByHash);
        // The language switcher keeps the anchor (E3 §5.3).
        document.querySelectorAll("a[hreflang]").forEach(function (a) {
          a.addEventListener("click", function () { a.hash = location.hash; });
        });

        // 2. Photo viewer: one <dialog> for the page. Without JavaScript a photo link opens the photo.
        var dlg = document.querySelector("dialog.viewer");
        if (!dlg || typeof dlg.showModal !== "function") return;
        var img = dlg.querySelector("img"), cap = dlg.querySelector(".viewer-cap"), count = dlg.querySelector(".viewer-count");
        var template = dlg.getAttribute("data-count") || "{n} / {total}";
        var set = [], idx = 0, opener = null;
        function show(i) {
          idx = (i + set.length) % set.length;
          var a = set[idx];
          img.src = a.getAttribute("href");
          img.alt = a.querySelector("img").alt;
          cap.textContent = a.getAttribute("data-caption") || "";
          count.textContent = template.replace("{n}", idx + 1).replace("{total}", set.length);
          dlg.querySelectorAll(".viewer-prev, .viewer-next").forEach(function (b) { b.hidden = set.length < 2; });
        }
        document.querySelectorAll("[data-gallery] a.ph").forEach(function (a) {
          a.addEventListener("click", function (e) {
            if (e.metaKey || e.ctrlKey || e.shiftKey) return;
            e.preventDefault();
            set = Array.prototype.slice.call(a.closest("[data-gallery]").querySelectorAll("a.ph"));
            opener = a;
            show(set.indexOf(a));
            dlg.showModal();
          });
        });
        dlg.querySelector(".viewer-prev").addEventListener("click", function () { show(idx - 1); });
        dlg.querySelector(".viewer-next").addEventListener("click", function () { show(idx + 1); });
        dlg.querySelector(".viewer-close").addEventListener("click", function () { dlg.close(); });
        dlg.addEventListener("keydown", function (e) {
          if (e.key === "ArrowLeft") show(idx - 1);
          if (e.key === "ArrowRight") show(idx + 1);
        });
        dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener("close", function () { img.removeAttribute("src"); if (opener) opener.focus(); });
      })();
    </script>
  </body>
</html>
